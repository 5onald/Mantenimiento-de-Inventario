* {
    box-sizing: border-box;
}

:root {
    --color-fondo: #9CA3AF;
    --color-secundario: #1F2937;
    --color-acento: #4B5563;
    --color-oscuro: #111827;
    --color-texto: #EDEDED;
    --color-fondo-secundario: #f0eae0;
}

body {
    min-height: 100vh;
    margin: 0;
    color: var(--color-oscuro);
    background-color: var(--color-fondo-secundario);
    font-family: "Plus Jakarta Sans", Arial, sans-serif;
}

header {
    padding: 1rem 2rem;
    background-color: var(--color-oscuro);
    color: var(--color-texto);
}

#menu-nav {
    max-width: 85rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
}

.nav-left h1 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
}

.nav-right {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.75rem;
}

.nav-right a {
    color: var(--color-fondo);
    text-decoration: none;
}

.nav-right a:hover, .nav-right a:focus-visible {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
}

main {
    width: min(100%, 89rem);
    margin: 0 auto;
    padding: 3rem 2rem;
}

.equipos-card {
    overflow: hidden;
    border: 1px solid rgba(31, 41, 55, 0.12);
    border-radius: 14px;
    background-color: #fff;
    box-shadow: 0 12px 30px rgba(17, 24, 39, 0.08);
}

.equipos-card-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.75rem 2rem 1.25rem;
}

.eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-acento);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.equipos-card h2 {
    margin: 0;
    color: var(--color-oscuro);
    font-size: 1.65rem;
}

.tabla-ayuda {
    margin: 0 0 0.2rem;
    color: var(--color-acento);
    font-size: 0.85rem;
}

#mensaje:empty {
    display: none;
}

#mensaje:not(:empty) {
    margin: 0 2rem 1rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background-color: #f3f4f6;
    color: var(--color-secundario);
}

.tabla-container {
    overflow-x: auto;
    border-top: 1px solid #e5e7eb;
}

table {
    width: 100%;
    min-width: 1120px;
    border-collapse: collapse;
    text-align: left;
}

th,
td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
}

th {
    background-color: var(--color-secundario);
    color: var(--color-texto);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
}

td {
    color: var(--color-oscuro);
    font-size: 0.875rem;
}

tbody tr:nth-child(even) {
    background-color: #f9fafb;
}

tbody tr:hover {
    background-color: #f0eae0;
}

tbody tr:last-child td {
    border-bottom: 0;
}

@media (max-width: 760px) {
    header {
        padding: 1rem;
    }

    #menu-nav {
        align-items: flex-start;
        flex-direction: column;
        gap: 1rem;
    }

    .nav-right {
        justify-content: flex-start;
        gap: 1rem;
    }

    main {
        padding: 1.5rem 1rem;
    }

    .equipos-card-header {
        align-items: flex-start;
        flex-direction: column;
        padding: 1.25rem;
    }

    #mensaje:not(:empty) {
        margin-right: 1.25rem;
        margin-left: 1.25rem;
    }
}
